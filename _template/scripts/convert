#!/usr/bin/env bash
# convert — extract plain text from the non-text sources in raw/ into a rebuildable cache, so
# an agent that cannot open a binary document can still read what is in it.
#
#   ./scripts/convert              convert anything new or changed under raw/
#   ./scripts/convert --dry-run    say what would be converted; write nothing
#   ./scripts/convert <raw-path>   convert one source (path relative to raw/, or a full path)
#
# Why this exists: no language model reads a .docx. It is a zip of XML, and a model that is
# handed the bytes sees nothing useful. This is true of frontier and local models alike, so the
# extraction step belongs here, deterministic and model-independent, rather than being a
# capability that silently varies with whichever agent is configured.
#
# raw/ is never touched. Output goes to .ingest/text/, which is derived state: delete it and
# re-run to rebuild. .ingest/text/index.tsv records what was converted, by which tool, and
# whether it produced anything.
#
# Routing by extension, cheapest tool that can do the job:
#   .docx .odt .rtf .html .htm .epub   pandoc -t plain
#   .xlsx                              xlsx2csv
#   .doc                               catdoc
#   .xls                               xls2csv     (catdoc package)
#   .ppt                               catppt      (catdoc package)
#   .pdf                               pdftotext; a PDF that yields almost nothing is a scan,
#                                      recorded as status=scanned for an OCR or vision pass
#   text-ish and images                skipped: the agent reads those directly
#
# A missing tool is a skip with a warning, never a failure: a KB with no pandoc still converts
# its PDFs. Install what you need (Debian: pandoc poppler-utils xlsx2csv catdoc).

set -eu

KB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$KB_DIR/scripts/kblib.sh"   # .ingestignore filter
RAW="$KB_DIR/raw"
OUT="$KB_DIR/.ingest/text"
INDEX="$OUT/index.tsv"
INDEX_HEADER=$'# index.tsv — raw source → extracted text (derived; delete .ingest/text to rebuild).\n# Columns: path\tsize\tmtime\ttool\tstatus\tout\tdate'
# A PDF with no text layer is a scan, and pdftotext returns essentially nothing for one: a form
# feed per page and no words. So the question is whether ANY text came back, not how much, and
# the floor sits just above a stray artifact such as a digitally stamped page number rather than
# at a word count. Counting raw bytes against a high floor called every short document, an
# invoice or a cover page or a one-line letter, a scan and sent it for OCR it never needed.
SCAN_FLOOR="${CONVERT_SCAN_FLOOR:-4}"

DRY=0; ONE=""
case "${1:-}" in
  --dry-run) DRY=1;;
  "") ;;
  -*) echo "convert: unknown flag '$1'" >&2; exit 1;;
  *)  ONE="$1";;
esac

[ -d "$RAW" ] || { echo "convert: no raw/ yet."; exit 0; }

# Say so before walking: a living source that does not resolve here makes the corpus look empty
# instead of unreachable, and a clean "0 converted" is the worst possible way to find out.
# An ABSOLUTE symlink breaks in a container even when its target is inside KB_ROOT, because the
# root is mounted somewhere else (/knowledge) and the host path does not exist there. A relative
# one pointing inside the root works fine. That distinction decides the advice, so give it.
unresolved=0
for _u in $(kb_unresolved_sources "$RAW"); do
  _t="$(readlink "$RAW/$_u" 2>/dev/null || true)"
  case "$_t" in
    /*) echo "convert: raw/$_u -> $_t does not resolve here. It is an ABSOLUTE link, so it breaks wherever that path is absent, including inside a container even when the target is under KB_ROOT." >&2
        echo "  fix: mount $_t at that same path (pinky's bootstrap does this for you), or make the link relative if its target is under the KB root." >&2;;
    *)  echo "convert: raw/$_u -> ${_t:-?} does not resolve here, so its sources are invisible. Run where the mount exists (not in a container)." >&2;;
  esac
  unresolved=$((unresolved + 1))
done
mkdir -p "$OUT"
[ -f "$INDEX" ] || printf '%s\n' "$INDEX_HEADER" > "$INDEX"

have() { command -v "$1" >/dev/null 2>&1; }
warned=""
warn_missing() {
  case " $warned " in *" $1 "*) return 0;; esac
  warned="$warned $1"
  echo "convert: $1 not installed; skipping $2 sources." >&2
}

# tool_for <lowercased-extension>: echo "<tool> <status-if-missing>", or nothing to skip.
tool_for() {
  case "$1" in
    docx|odt|rtf|html|htm|epub) echo pandoc;;
    xlsx)                       echo xlsx2csv;;
    doc)                        echo catdoc;;
    xls)                        echo xls2csv;;
    ppt)                        echo catppt;;
    pdf)                        echo pdftotext;;
    *)                          echo "";;
  esac
}

# extract <tool> <src> <dest>: run the tool, leaving <dest> written (possibly empty).
extract() {
  case "$1" in
    pandoc)    pandoc -t plain --wrap=none "$2" -o "$3" 2>/dev/null || : > "$3";;
    xlsx2csv)  xlsx2csv -a "$2" > "$3" 2>/dev/null || : > "$3";;
    catdoc)    catdoc -w "$2" > "$3" 2>/dev/null || : > "$3";;
    xls2csv)   xls2csv -x "$2" > "$3" 2>/dev/null || : > "$3";;
    catppt)    catppt "$2" > "$3" 2>/dev/null || : > "$3";;
    pdftotext) pdftotext -layout -q "$2" "$3" 2>/dev/null || : > "$3";;
  esac
  [ -f "$3" ] || : > "$3"
}

# index_lookup <path>: echo the recorded "size mtime" for a path, or nothing.
index_lookup() {
  awk -F'\t' -v p="$1" '$1==p {print $2" "$3; exit}' "$INDEX"
}

converted=0; skipped=0; scans=0; unchanged=0; empties=0

# Follow symlinks: a living source is a link into a mount, and its files are the point.
if [ -n "$ONE" ]; then
  case "$ONE" in /*) list="$ONE";; raw/*) list="$KB_DIR/$ONE";; *) list="$RAW/$ONE";; esac
  [ -e "$list" ] || { echo "convert: no such source '$ONE'" >&2; exit 1; }
  files="$(find -L "$list" -type f 2>/dev/null || true)"
else
  files="$(find -L "$RAW" -type f 2>/dev/null || true)"
fi

for f in $files; do
  base="${f##*/}"
  kb_ignored "$base" && continue
  [ -s "$f" ] || continue                       # zero-byte: possibly mid-download, leave it

  ext="$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')"
  [ "$ext" = "$base" ] && continue              # no extension: nothing to route on
  tool="$(tool_for "$ext")"
  [ -n "$tool" ] || continue                    # text, images, unknown: the agent reads directly

  rel="${f#"$RAW"/}"
  size="$(wc -c < "$f" | tr -d ' ')"
  mtime="$(date -r "$f" +%s 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)"
  if [ "$(index_lookup "$rel")" = "$size $mtime" ]; then unchanged=$((unchanged + 1)); continue; fi

  if ! have "$tool"; then warn_missing "$tool" ".$ext"; skipped=$((skipped + 1)); continue; fi

  if [ "$DRY" -eq 1 ]; then
    echo "convert: [dry-run] $rel → $tool"; converted=$((converted + 1)); continue
  fi

  # Output name: the source path flattened, so the cache is browsable and collision-free.
  outname="$(printf '%s' "$rel" | tr '/' '_' | tr -c 'A-Za-z0-9._-' '-').txt"
  dest="$OUT/$outname"
  extract "$tool" "$f" "$dest"
  # pdftotext appends its own .txt when handed a bare destination; normalise either result.
  [ -f "$dest.txt" ] && mv "$dest.txt" "$dest"

  chars="$(tr -d '[:space:]\f' < "$dest" | wc -c | tr -d ' ')"   # words, not page breaks
  status=ok
  if [ "$ext" = pdf ] && [ "$chars" -lt "$SCAN_FLOOR" ]; then
    status=scanned                              # no text layer: needs OCR or a vision pass
    scans=$((scans + 1))
  elif [ "$chars" -lt 1 ]; then
    # The tool ran and produced nothing. Usually it failed, or the file is not what its
    # extension claims. Either way it is not "converted", so say so rather than counting it.
    status=empty
    empties=$((empties + 1))
  fi

  grep -v -F "$(printf '%s\t' "$rel")" "$INDEX" > "$INDEX.tmp" 2>/dev/null || cp "$INDEX" "$INDEX.tmp"
  mv "$INDEX.tmp" "$INDEX"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$rel" "$size" "$mtime" "$tool" "$status" "$outname" "$(date +%F)" >> "$INDEX"
  echo "convert: $rel → $outname ($tool, $status)"
  converted=$((converted + 1))
done

if [ "$DRY" -eq 1 ]; then
  m="convert: [dry-run] $converted to convert, $unchanged unchanged, $skipped skipped"
  [ "$unresolved" -gt 0 ] && m="$m; $unresolved living source(s) UNREACHABLE here"
  echo "$m. Nothing written."
  exit 0
fi
msg="convert: $converted converted, $unchanged unchanged"
[ "$unresolved" -gt 0 ] && msg="$msg; $unresolved living source(s) UNREACHABLE here"
[ "$skipped" -gt 0 ] && msg="$msg, $skipped skipped (missing tools)"
[ "$empties" -gt 0 ] && msg="$msg; $empties yielded NO TEXT (status=empty — the tool failed, or the file is not what its extension says)"
[ "$scans"   -gt 0 ] && msg="$msg; $scans PDF(s) have no text layer (status=scanned — OCR or a vision pass)"
echo "$msg."
