#!/usr/bin/env bash
# sweep — move staged sources into raw/, setting obvious junk aside and never touching
# anything that might be mid-download. Two inputs feed it:
#
#   inbox/    a SHAREABLE staging directory: unprivileged contributors drop files there.
#   capture/  an OPTIONAL external intake queue, shared across KBs and living beside them, not
#             inside one. Something outside this KB puts items there (a phone upload, an agent
#             submission) and records a triage decision in each item's sidecar,
#             capture/.meta/<id>.json:  "promoted": { "kb", "at", "by" }. An item is swept only
#             once a decision names THIS KB. A KB with no sibling capture/ sweeps inbox/ and is
#             otherwise unaffected.
#
# Promotion is a recorded decision, not a move, so whatever receives captures needs no write
# access to a KB at all. Sweep, which already runs with write access to raw/, is what acts on
# it. An item with no promotion, or one naming another KB, is left in the queue. A missing or
# unreadable sidecar means "not promoted", so the failure direction is always "stays put".
#
# This sweep MOVES each curated item into raw/ (the protected store), so once curated a
# source leaves the shared area entirely — contributors can't read, alter, or delete it.
# Share only inbox/; never share raw/ or the KB root.
#
# Routing (a move is a one-way commitment, so only confident cases move):
#   - raw/   real, fully-present content. A SYMLINK is moved as a link: mv relocates the link
#            itself, so its target stays at its origin and is never walked, read, or copied. A
#            living-source symlink dropped in inbox/ therefore lands in raw/ still pointing at the
#            same place (the intended living-source model), with zero risk to the origin.
#   - junk/  non-empty names matching .ingestignore (system cruft, temp/lock files). Safe to move.
#   - HELD   zero-byte files, and REAL directories (not symlinks) that contain zero-byte files, are
#            LEFT IN PLACE and flagged. A zero-byte file may be a real document that has not
#            finished downloading (an un-synced cloud placeholder); moving it can cancel the
#            download and lose it. Wait for it to sync (then re-sweep) or delete it.
#
# CAUTION: only zero-byte un-synced files are detectable. A macOS dataless placeholder reports its
# full size and cannot be detected here, and any mv from a synced inbox can disturb the sync
# engine. Make sure inbox/ contents are fully downloaded before sweeping.
#
#   ./scripts/sweep            move ready sources inbox/ + promoted capture/ → raw/, commit, flag held
#   ./scripts/sweep --dry-run  show what would happen; change nothing
#
# On a name collision the incoming item is renamed with a timestamp suffix; nothing is clobbered.
#
# KB_CAPTURE_DIR overrides the queue location (default: capture/ beside the KB).

set -euo pipefail

DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1

KB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$KB_DIR/scripts/kblib.sh"   # kb_skip_reason / kb_dir_has_unsynced (.ingestignore + un-synced)
INBOX="$KB_DIR/inbox"
RAW="$KB_DIR/raw"
JUNK="$KB_DIR/junk"
KB_NAME="$(basename "$KB_DIR")"
# PINKY_CAPTURE_DIR is honoured too, for a host that already sets it.
CAPTURE="${KB_CAPTURE_DIR:-${PINKY_CAPTURE_DIR:-$(cd "$KB_DIR/.." && pwd)/capture}}"
STAMP="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$RAW" "$JUNK"

# safe_dest <destdir> <basename>: echo a path in destdir that does not clobber an existing entry.
safe_dest() {
  local d="$1" b="$2"
  if [ -e "$d/$b" ]; then
    if [ "${b%.*}" = "$b" ]; then echo "$d/${b}-$STAMP"; else echo "$d/${b%.*}-$STAMP.${b##*.}"; fi
  else
    echo "$d/$b"
  fi
}

moved=0; junked=0; held=0; names=()

# route <path> <label>: decide raw/junk/held for one staged item and act on it.
# <label> is how the item is named in output ("inbox/x" or "capture/x"). Echoes the
# destination basename on a move so the caller can record it; sets ROUTE to the outcome.
ROUTE=""
route() {
  local item="$1" label="$2" base reason dest
  base="$(basename "$item")"
  reason="$(kb_skip_reason "$item" || true)"           # review (zero-byte file) | junk | ''
  # A REAL directory (not a symlink) with un-synced files inside is risky to move: a
  # cross-filesystem mv copies, hence reads, every file. A symlink is always safe to move — mv
  # relocates the link, never walking or touching the target — so it is never held here, and its
  # (possibly huge, possibly un-synced) target is never traversed.
  if [ "$reason" != review ] && [ -d "$item" ] && [ ! -L "$item" ] && kb_dir_has_unsynced "$item"; then
    reason=review                                      # real directory mid-sync: do not move it
  fi

  if [ "$reason" = review ]; then
    echo "sweep: HELD $label — empty or possibly un-synced; left in place. Finish the download (then re-sweep) or delete it."
    ROUTE=held; held=$((held + 1)); return 0
  fi
  if [ "$reason" = junk ]; then
    dest="$(safe_dest "$JUNK" "$base")"
    if [ "$DRY" -eq 1 ]; then echo "sweep: [dry-run] $label → junk/$(basename "$dest") (.ingestignore)"
    else mv "$item" "$dest"; echo "sweep: junk → junk/$(basename "$dest") (matched .ingestignore)"; fi
    ROUTE=junk; junked=$((junked + 1)); return 0
  fi

  dest="$(safe_dest "$RAW" "$base")"
  if [ "$DRY" -eq 1 ]; then echo "sweep: [dry-run] $label → raw/$(basename "$dest")"
  else mv "$item" "$dest"; echo "sweep: moved $label → raw/$(basename "$dest")"; fi
  names+=("$(basename "$dest")"); ROUTE=raw; moved=$((moved + 1))
}

# --- inbox/: the shared staging directory ------------------------------------
shopt -s nullglob
if [ -d "$INBOX" ]; then
  for item in "$INBOX"/*; do
    base="$(basename "$item")"
    [ "$base" = "README.md" ] && continue
    route "$item" "inbox/$base"
  done
fi

# --- capture/: items triage has promoted to THIS KB --------------------------
# The sidecar is the authority. Its id comes from the sidecar's own filename and is
# re-validated against the server's id charset before any filesystem use, so a hand-written
# sidecar cannot name a path outside the queue. The kb value is only ever compared for
# equality with this KB's directory name; it is never joined into a path.
if [ -d "$CAPTURE/.meta" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "sweep: jq not found — cannot read capture promotions; inbox/ swept, capture/ left alone." >&2
  else
    for mf in "$CAPTURE"/.meta/*.json; do
      id="$(basename "$mf" .json)"
      case "$id" in
        .*|*/*) continue;;                                  # never a relative or nested name
        *[!A-Za-z0-9._-]*) continue;;                       # server's capture-id charset
      esac
      [ -e "$CAPTURE/$id" ] || continue                     # sidecar with no payload: nothing to move
      kb="$(jq -r '.promoted.kb // empty' "$mf" 2>/dev/null || true)"
      [ "$kb" = "$KB_NAME" ] || continue                    # unpromoted, or promoted elsewhere

      route "$CAPTURE/$id" "capture/$id"
      # Retire the sidecar alongside the payload it describes, so the provenance record
      # survives the move and a re-run does not reconsider a decision already acted on.
      if [ "$DRY" -eq 0 ] && [ "$ROUTE" != held ]; then
        mkdir -p "$CAPTURE/.done"
        mv "$mf" "$CAPTURE/.done/$id.json"
      fi
    done
  fi
fi
shopt -u nullglob

total=$((moved + junked + held))
if [ "$total" -eq 0 ]; then echo "sweep: inbox/ and capture/ empty — nothing to sweep."; exit 0; fi
if [ "$DRY" -eq 1 ]; then
  echo "sweep: [dry-run] $moved → raw/, $junked → junk/, $held held in place. Nothing changed."
  exit 0
fi

# Record the custody move. raw/ and inbox/ contents are both gitignored, so this usually
# stages nothing: the sources themselves are never versioned, and backup is what covers them.
# Commit only when something actually changed, rather than reporting a failure every sweep.
if [ "$moved" -gt 0 ] && command -v git >/dev/null 2>&1 && git -C "$KB_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$KB_DIR" add -A -- raw inbox >/dev/null 2>&1 || true
  if ! git -C "$KB_DIR" diff --cached --quiet 2>/dev/null; then
    body="$(printf 'raw/%s\n' "${names[@]}")"
    git -C "$KB_DIR" commit -q -m "Sweep: $moved source(s) → raw" -m "$body" >/dev/null 2>&1 || true
  fi
fi

msg="sweep: $moved moved into raw/"
[ "$junked" -gt 0 ] && msg="$msg; $junked set aside in junk/ (delete when ready)"
[ "$held"   -gt 0 ] && msg="$msg; $held held in place (empty or un-synced — review)"
echo "$msg."
