#!/usr/bin/env bash
#
# new-kb — scaffold a new LLM-maintained knowledge base from the template.
#
# Usage:
#   ./scripts/new-kb <kb-name> [<KB Title>] [<target-parent-dir>]
#
#   <kb-name>            kebab-case directory name for the KB (required)
#   <KB Title>          human-readable title (default: derived from kb-name)
#   <target-parent-dir> where to create the KB (default: the kit's parent dir)
#
# Creates <target-parent-dir>/<kb-name> from _template/, substitutes placeholders,
# and runs `git init` + an initial commit. Refuses to write into a non-empty dir.

set -euo pipefail

die() { printf 'error: %s\n' "$1" >&2; exit 1; }

# --- resolve paths -----------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATE_DIR="$KIT_DIR/_template"
[ -d "$TEMPLATE_DIR" ] || die "template not found at $TEMPLATE_DIR"

# --- args --------------------------------------------------------------------
KB_NAME="${1:-}"
[ -n "$KB_NAME" ] || die "usage: new-kb <kb-name> [<KB Title>] [<target-parent-dir>]"

printf '%s' "$KB_NAME" | grep -Eq '^[a-z0-9][a-z0-9-]*$' \
  || die "kb-name must be kebab-case (lowercase letters, digits, hyphens): got '$KB_NAME'"

# default title: kebab-name -> Title Case
default_title="$(printf '%s' "$KB_NAME" | tr '-' ' ' \
  | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1)) substr($i,2)}}1')"
KB_TITLE="${2:-$default_title}"

PARENT_DIR="${3:-$(cd "$KIT_DIR/.." && pwd)}"
[ -d "$PARENT_DIR" ] || die "target parent dir does not exist: $PARENT_DIR"

TARGET="$PARENT_DIR/$KB_NAME"

# refuse to clobber a non-empty existing dir
if [ -e "$TARGET" ]; then
  [ -d "$TARGET" ] || die "target exists and is not a directory: $TARGET"
  [ -z "$(ls -A "$TARGET" 2>/dev/null)" ] || die "target dir is not empty: $TARGET"
else
  mkdir -p "$TARGET"
fi

DATE="$(date +%F)"
YEAR="$(date +%Y)"

# --- copy template -----------------------------------------------------------
cp -R "$TEMPLATE_DIR"/. "$TARGET"/

# --- substitute placeholders (values passed via env so special chars are safe) -
find "$TARGET" -type f ! -path '*/.git/*' -print0 | while IFS= read -r -d '' f; do
  KB_NAME="$KB_NAME" KB_TITLE="$KB_TITLE" DATE="$DATE" YEAR="$YEAR" \
  perl -pi -e '
    s/\{\{KB_NAME\}\}/$ENV{KB_NAME}/g;
    s/\{\{KB_TITLE\}\}/$ENV{KB_TITLE}/g;
    s/\{\{DATE\}\}/$ENV{DATE}/g;
    s/\{\{YEAR\}\}/$ENV{YEAR}/g;
  ' "$f"
done

# --- record which kit produced the kit-owned files ---------------------------
# Checksums are taken AFTER substitution, of the files as installed, because the title is
# written into several of them and they would otherwise never match the template again.
# scripts/upgrade reads this to tell a file it may refresh from one somebody has edited.
_sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
         else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
KIT_SOURCE="${KB_KIT_SOURCE:-$(git -C "$KIT_DIR" remote get-url origin 2>/dev/null || echo "$KIT_DIR")}"
KIT_VERSION="$(git -C "$KIT_DIR" rev-parse --short HEAD 2>/dev/null || echo local)"
{
  echo "# .kit — which kit produced this KB's kit-owned files. Script-owned; do not edit."
  echo "# Columns: kind<TAB>...   meta: key/value.   file: path/sha256/tracked|pinned."
  printf 'meta\tsource\t%s\n' "$KIT_SOURCE"
  printf 'meta\tversion\t%s\n' "$KIT_VERSION"
  printf 'meta\tinstalled\t%s\n' "$DATE"
  printf 'meta\tkb_name\t%s\n' "$KB_NAME"
  printf 'meta\tkb_title\t%s\n' "$KB_TITLE"
  printf 'meta\tseeded\t%s\n' "$DATE"
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue;; esac
    case "$line" in
      */) [ -d "$TARGET/$line" ] || continue
          (cd "$TARGET" && find "$line" -type f | sort);;
      *)  [ -f "$TARGET/$line" ] && printf '%s\n' "$line";;
    esac
  done < "$TEMPLATE_DIR/.kit-owned" | while IFS= read -r f; do
    printf 'file\t%s\t%s\ttracked\n' "$f" "$(_sha "$TARGET/$f")"
  done
} > "$TARGET/.kit"

# --- git init ----------------------------------------------------------------
if command -v git >/dev/null 2>&1; then
  git -C "$TARGET" init -q
  git -C "$TARGET" add -A
  if ! git -C "$TARGET" commit -q -m "Scaffold $KB_TITLE knowledge base from llm-wiki-gen"; then
    echo "note: nothing committed — configure git user.name/email, then commit manually."
  fi
else
  echo "note: git not found — skipped 'git init'."
fi

# --- done --------------------------------------------------------------------
cat <<EOF

✓ Created knowledge base: $TARGET

Next steps:
  cd "$TARGET"
  # open in Claude Code (CLAUDE.md points at AGENTS.md); other agents read AGENTS.md
  # open wiki/ as an Obsidian vault
  # add sources to raw/ (files, folders, or: ln -s <living-source> raw/<name>)
  # then ask the agent to ingest them
EOF
